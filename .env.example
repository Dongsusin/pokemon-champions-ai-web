VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Server-only bug report delivery. Never prefix these values with VITE_.
# Activate the receiving email in FormSubmit before enabling production.
BUG_REPORT_ENABLED=false
BUG_REPORT_PROVIDER=formsubmit
BUG_REPORT_TO=your-report-inbox@example.com
BUG_REPORT_ALLOWED_ORIGINS=https://your-game-domain.example

# Optional Resend delivery instead of FormSubmit.
# BUG_REPORT_PROVIDER=resend
# RESEND_API_KEY=your_server_only_api_key
# BUG_REPORT_FROM=Champions Arena <reports@your-verified-domain.example>
