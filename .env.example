VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Discord community bot: server-only, never use the VITE_ prefix.
# Keep the bot token in ignored local storage and Vercel environment settings.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_FREE_CHANNEL_ID=
DISCORD_BUG_CHANNEL_ID=
DISCORD_IDEA_CHANNEL_ID=
DISCORD_UPDATE_CHANNEL_ID=
# Optional existing moderator role. The server owner can manage the bot by default.
DISCORD_MODERATOR_ROLE_ID=

# Enable ranked battles only after configuring server authentication and storage.
# npm run ranked:test enables loopback test accounts for that process only.
VITE_RANKED_ENABLED=false
VITE_RANKED_API_URL=/api/ranked
RANKED_ENABLED=false
RANKED_FIREBASE_PROJECT_ID=
RANKED_FIRESTORE_PREFIX=ranked
# Optional server-only secret; never use a VITE_ prefix or commit its value.
RANKED_FIREBASE_SERVICE_ACCOUNT_JSON=
# Server-only Firebase Admin credentials: use GOOGLE_APPLICATION_CREDENTIALS
# pointing to an ignored local service account file, or the hosting identity.

# Game storage: keep Firebase Auth, route saves/sessions/ranked data to Postgres.
# Set BOTH provider flags to supabase in the same deployment after migration.
VITE_GAME_STORAGE_PROVIDER=firestore
GAME_STORAGE_PROVIDER=firestore
VITE_ACCOUNT_API_URL=/api/account
# Server-only dedicated champions_server role via Supabase transaction pooler.
# Never put either value in VITE_ variables, client files, or Git.
DATABASE_URL=
DATABASE_SSL_CA=

# Usage statistics share ranked API authentication and the selected game storage.
# Enable both flags in Production and rebuild after configuring RANKED_ENABLED.
VITE_POKEMON_USAGE_ENABLED=false
POKEMON_USAGE_ENABLED=false

# Cooperative boss raids are opt-in. Keep both flags off until separately
# authorizing a deployment. They reuse the authenticated game storage above.
VITE_RAID_ENABLED=false
VITE_RAID_API_URL=/api/raid
RAID_ENABLED=false
