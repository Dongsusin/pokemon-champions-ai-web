rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Historical backup only. Live game data is stored by the authenticated
    // account/ranked APIs in Supabase; old clients must not create split saves.
    match /players/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      match /gameData/{documentId} {
        allow read: if request.auth != null && request.auth.uid == userId;
      }
    }
    match /accountSessions/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }
  }
}
