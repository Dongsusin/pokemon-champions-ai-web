{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["icn1"],
  "headers": [
    {
      "source": "/assets/:file([A-Za-z0-9_-]+-[A-Za-z0-9_-]{8}\\.js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/:file([A-Za-z0-9_-]+-[A-Za-z0-9_-]{8}\\.css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/battle-factory": false,
      "codex/fixed-aspect-frame": false,
      "codex/boss-achievements": false
    }
  }
}
