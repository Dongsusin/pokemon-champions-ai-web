{
  "name": "pokemon-champions-ai-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run generate:resource-manifest",
    "dev": "vite",
    "prebuild": "npm run generate:resource-manifest",
    "build": "vite build",
    "preview": "vite preview",
    "generate:battle-items": "node scripts/generateBattleItemData.mjs",
    "generate:battle-moves": "node scripts/generateBattleMoveData.mjs",
    "generate:move-animations": "node scripts/generateMoveAnimationManifest.mjs",
    "import:move-animation-reference": "node scripts/importMoveAnimationReference.mjs",
    "sync:active-move-resources": "node scripts/syncActiveMoveResources.mjs",
    "validate:move-animations": "node scripts/validateMoveAnimationCoverage.mjs",
    "validate:move-quality": "node scripts/validateMoveAnimationCoverage.mjs && node scripts/validateMoveChoreography.mjs && node scripts/validateMovePainter.mjs",
    "validate:move-sounds": "node scripts/validateMoveSoundCoverage.mjs",
    "generate:battle-sounds": "node scripts/generateBattleSoundAssets.mjs",
    "validate:battle-audio": "node scripts/validateMoveSoundCoverage.mjs && node scripts/validateBattleAudio.mjs",
    "validate:battle-ai": "node scripts/validateBattleAi.mjs",
    "validate:battle-ai-decks": "node scripts/validateBattleAiDeckCoverage.mjs",
    "validate:battle-difficulty": "node scripts/validateBattleDifficulty.mjs",
    "validate:battle-move-conditions": "node scripts/validateBattleMoveConditions.mjs",
    "validate:battle-move-effects": "node scripts/validateBattleMoveEffects.mjs",
    "validate:battle-mechanics": "node scripts/validateBattleMechanicCoverage.mjs",
    "benchmark:battle-ai": "node scripts/benchmarkBattleAi.mjs",
    "validate:battle-gimmicks": "node scripts/validateBattleGimmickLimit.mjs",
    "validate:battle-abilities": "node scripts/validateBattleAbilityForms.mjs",
    "validate:battle-ability-effects": "node scripts/validateBattleAbilityEffects.mjs",
    "validate:season-megas": "node scripts/validateSeasonMegaAbilities.mjs && node scripts/validatePokemonForms.mjs",
    "validate:battle-status": "node scripts/validateBattleStatusAudit.mjs",
    "validate:battle-interactions": "node scripts/validateBattleAbilityAudit.mjs && node scripts/validateBattleMoveAudit.mjs && node scripts/validateBattleItemHpAudit.mjs && node scripts/validateBattleTargetingAudit.mjs",
    "validate:battle-state": "node scripts/validateBattleStateSweep.mjs",
    "validate:battle-audit": "npm run validate:battle-content && npm run validate:battle-status && npm run validate:battle-interactions && npm run validate:battle-state && npm run validate:battle-ai && npm run validate:battle-difficulty && npm run validate:battle-gimmicks && npm run validate:signature-z-moves && npm run validate:training-moves",
    "validate:trainer-dialogues": "node scripts/validateTrainerDialogues.mjs",
    "validate:battle-content": "npm run validate:battle-move-conditions && npm run validate:battle-move-effects && npm run validate:battle-mechanics && npm run validate:battle-abilities && npm run validate:battle-ability-effects && npm run validate:season-megas",
    "validate:signature-z-moves": "node scripts/validateSignatureZMoves.mjs",
    "generate:pokemon-data": "node scripts/generatePokemonData.mjs",
    "generate:pokemon-genders": "node scripts/generatePokemonGenderData.mjs",
    "validate:pokemon-learnsets": "node scripts/validatePokemonLearnsets.mjs",
    "validate:pokemon-forms": "node scripts/validatePokemonForms.mjs",
    "validate:training-moves": "node scripts/validateTrainingMoves.mjs",
    "validate:draw-pool": "node scripts/validatePokemonDrawPool.mjs",
    "validate:test-unlocks": "node scripts/validateTestUnlocks.mjs",
    "validate:account-sync": "node scripts/validateAccountGameData.mjs",
    "validate:account-session": "node scripts/validateAccountSession.mjs",
    "validate:achievements": "node scripts/validateBattleAchievementFacts.mjs && node scripts/validateAchievements.mjs && node scripts/validateAchievementStorage.mjs && node scripts/validateAccountGameData.mjs",
    "validate:achievements-ui": "node scripts/validateAchievementUi.mjs",
    "generate:sprite-manifest": "node scripts/generateGen5SpriteManifest.mjs",
    "generate:trainer-teams": "node scripts/generateTrainerTeams.mjs && node scripts/generateTrainerLoadouts.mjs",
    "generate:trainer-loadouts": "node scripts/generateTrainerLoadouts.mjs",
    "generate:resource-manifest": "node scripts/generateResourceManifest.mjs"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5"
  }
}
